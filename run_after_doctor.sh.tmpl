#!/usr/bin/env bash
# Linux-only: systemd and yay checks are not applicable on macOS
[[ "$(uname)" == "Darwin" ]] && exit 0
# Note: intentionally no set -e — the ((failed++)) arithmetic and eval'd checks
# would cause early exit. We want to run all checks and report results.

is_wsl=false
grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null && is_wsl=true

checks=(
    "command -v yay"
    "command -v session-manager-plugin"
    "test -x ~/.local/bin/clip-push"
    "test -x ~/.local/bin/clip-pull"
    "test -f ~/.ssh/config.d/ritual.conf"
    "test -f ~/.config/systemd/user/mnt-mac_airdrop.mount"
    "test -d {{ .mount.dir }}"
    "fish -c 'type -q fisher'"
    "fish -c \"fisher list 2>/dev/null | grep -q 'jorgebucaran/nvm.fish'\""
    "git -C ${XDG_CONFIG_HOME:-$HOME/.config}/nvim remote get-url origin 2>/dev/null | grep -qF 'git@github-personal:buildWithAlchemist/wand.git'"
    "uv tool list 2>/dev/null | grep -q '^wizard '"
)

if $is_wsl; then
    # Tailscale runs on the Windows host under WSL2, not as a local tailscaled
    checks+=("ssh -o BatchMode=yes -o ConnectTimeout=5 macbridge true")
else
    checks+=("systemctl is-enabled tailscaled")
    if systemctl is-active --quiet tailscaled; then
        checks+=("ssh -o BatchMode=yes -o ConnectTimeout=5 macbridge true")
    fi
fi

failed=0
for check in "${checks[@]}"; do
    if ! eval "$check" &>/dev/null; then
        echo "[ritual] WARN: failed check: $check"
        ((failed++))
    fi
done

if [ "$failed" -eq 0 ]; then
    echo "[ritual] All checks passed"
else
    echo "[ritual] $failed check(s) failed"
fi
