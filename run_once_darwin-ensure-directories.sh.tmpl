#!/usr/bin/env bash
set -euo pipefail

# macOS-only: the Linux variant of this script handles other platforms
[[ "$(uname)" != "Darwin" ]] && exit 0

dirs=(
    "{{ .repos.personal }}"
    "{{ .repos.work }}"
)

for dir in "${dirs[@]}"; do
    expanded="${dir/#\~/$HOME}"
    mkdir -p "$expanded"
done
