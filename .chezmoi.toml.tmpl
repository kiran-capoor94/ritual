{{- $macHostname := promptString "Mac Tailscale hostname" "" -}}
{{- $macUser := promptString "Mac username" "" -}}
{{- $macIdentityFile := promptString "SSH key for Mac (absolute path, e.g. /home/you/.ssh/id_ed25519)" (printf "%s/.ssh/id_ed25519" .chezmoi.homeDir) -}}
{{- $macAirdropPath := promptString "Mac AirDrop path (e.g. /Users/you/Downloads)" "" -}}
{{- $githubPersonalKey := promptString "SSH key for personal GitHub (absolute path)" (printf "%s/.ssh/id_ed25519_personal" .chezmoi.homeDir) -}}
{{- $githubWorkKey := promptString "SSH key for work GitHub (absolute path)" (printf "%s/.ssh/id_ed25519_work" .chezmoi.homeDir) -}}
{{- $personalName := promptString "Personal git name" -}}
{{- $personalEmail := promptString "Personal git email" -}}
{{- $workName := promptString "Work git name" -}}
{{- $workEmail := promptString "Work git email" -}}
{{- $commitName := promptString "Git commit display name (author name on every commit, both trees)" "Kiran Capoor" -}}

[data.mac]
hostname = {{ $macHostname | quote }}
user = {{ $macUser | quote }}
identity_file = {{ $macIdentityFile | quote }}
airdrop_path = {{ $macAirdropPath | quote }}

[data.mount]
# Must stay in sync with the systemd unit filename (dot_config/systemd/user/mnt-mac_airdrop.mount.tmpl):
# systemd requires a mount unit's filename to be the escaped form of its Where= path.
dir = "/mnt/mac_airdrop"

[data.github.personal]
host = "github-personal"
key = {{ $githubPersonalKey | quote }}

[data.github.work]
host = "github-work"
key = {{ $githubWorkKey | quote }}

[data.identity.personal]
name = {{ $personalName | quote }}
email = {{ $personalEmail | quote }}

[data.identity.work]
name = {{ $workName | quote }}
email = {{ $workEmail | quote }}

[data.git]
# The human name recorded as commit author. Distinct from identity.*.name, which
# holds GitHub usernames and must not be used here.
commit_name = {{ $commitName | quote }}
